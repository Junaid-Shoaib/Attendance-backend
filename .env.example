APP_NAME="Attendance Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=attendance_management
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

QUEUE_CONNECTION=database
CACHE_STORE=database

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1
SANCTUM_TOKEN_EXPIRATION=43200

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@attendance.app"
MAIL_FROM_NAME="${APP_NAME}"

FIREBASE_CREDENTIALS=storage/app/firebase/firebase_credentials.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# Attendance / Geofencing settings
ATTENDANCE_DEFAULT_GEOFENCE_RADIUS_METERS=200
ATTENDANCE_ALLOW_MOCK_LOCATION=false
ATTENDANCE_BLOCK_ROOTED_DEVICES=true
ATTENDANCE_REQUIRE_SELFIE=false
ATTENDANCE_DEVICE_BINDING_ENABLED=true
ATTENDANCE_MAX_TIME_DRIFT_MINUTES=5

FILESYSTEM_DISK=public
